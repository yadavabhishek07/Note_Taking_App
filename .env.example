# Optional: Connect to external PostgreSQL (e.g. Neon, Supabase, Docker, local postgres)
# If left commented or empty, the app automatically runs embedded PGlite (WASM PostgreSQL) with zero setup!
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/note_taking_db"

# JWT Secret for session authentication
JWT_SECRET="super-secret-secure-jwt-key-change-in-production-12345"

# Public App Base URL (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
